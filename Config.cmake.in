@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies

include("${CMAKE_CURRENT_LIST_DIR}/cmake/bootstrap_pyyggdrasil.cmake")

find_dependency(yggdrasil @LOKI_YGGDRASIL_REQUIRED_VERSION@ CONFIG PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH)
yggdrasil_register_native_dependency_prefix("${YGGDRASIL_NATIVE_PREFIX}")

# Components

set(_loki_supported_components parsers)
if(NOT loki_FIND_COMPONENTS)
    set(loki_FIND_COMPONENTS parsers)
endif()

foreach(_component IN LISTS loki_FIND_COMPONENTS)
    if(_component IN_LIST _loki_supported_components)
        set(loki_${_component}_FOUND TRUE)
    else()
        set(loki_${_component}_FOUND FALSE)
        if(loki_FIND_REQUIRED_${_component})
            set(loki_FOUND FALSE)
            set(loki_NOT_FOUND_MESSAGE "Unsupported component: ${_component}")
            unset(_component)
            unset(_loki_supported_components)
            return()
        endif()
    endif()
endforeach()

# Targets

include("${CMAKE_CURRENT_LIST_DIR}/lokiparsersTargets.cmake")

unset(_component)
unset(_loki_supported_components)
