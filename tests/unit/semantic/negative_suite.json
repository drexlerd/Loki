{
    "cases": [
        {
            "name": "strict undefined predicate",
            "entry": "domain",
            "expected_error": "UndefinedPredicateError",
            "expected_message": "Undefined predicate: missing",
            "strict": true,
            "domain": [
                "(define (domain strict-undefined)",
                "  (:predicates)",
                "  (:action a :parameters () :precondition (missing) :effect (and))",
                ")"
            ]
        },
        {
            "name": "duplicate predicate",
            "entry": "domain",
            "expected_error": "DuplicatePredicateError",
            "expected_message": "Duplicate predicate definition: p",
            "domain": [
                "(define (domain duplicate-predicate)",
                "  (:predicates (p) (p))",
                ")"
            ]
        },
        {
            "name": "strict missing disjunction requirement",
            "entry": "domain",
            "expected_error": "MissingRequirementError",
            "strict": true,
            "expected_message": "Missing required PDDL requirement: :disjunctive-preconditions",
            "expected_line": 3,
            "expected_column": 43,
            "domain": [
                "(define (domain missing-disjunction-requirement)",
                "  (:predicates (p) (q))",
                "  (:action a :parameters () :precondition (or (p) (q)) :effect (and))",
                ")"
            ]
        },
        {
            "name": "strict missing equality requirement",
            "entry": "domain",
            "expected_error": "MissingRequirementError",
            "expected_message": "Missing required PDDL requirement: :equality",
            "strict": true,
            "domain": [
                "(define (domain missing-equality-requirement)",
                "  (:predicates)",
                "  (:action a :parameters (?x ?y) :precondition (= ?x ?y) :effect (and))",
                ")"
            ]
        },
        {
            "name": "invalid equality arity",
            "entry": "domain",
            "expected_error": "InvalidEqualityError",
            "expected_message": "Invalid equality expression: expected 2 terms, got 3",
            "domain": [
                "(define (domain invalid-equality)",
                "  (:requirements :equality)",
                "  (:predicates)",
                "  (:action a :parameters (?x ?y ?z) :precondition (= ?x ?y ?z) :effect (and))",
                ")"
            ]
        },
        {
            "name": "strict predicate type mismatch",
            "entry": "domain",
            "expected_error": "TypeMismatchError",
            "strict": true,
            "domain": [
                "(define (domain predicate-type-mismatch)",
                "  (:requirements :typing)",
                "  (:types room ball)",
                "  (:constants b - ball)",
                "  (:predicates (at ?r - room))",
                "  (:action a :parameters () :precondition (at b) :effect (and))",
                ")"
            ]
        },
        {
            "name": "invalid metric optimization",
            "entry": "task",
            "expected_error": "InvalidMetricError",
            "expected_message": "Invalid metric optimization: smallest",
            "domain": [
                "(define (domain metric-domain)",
                "  (:requirements :numeric-fluents)",
                "  (:predicates)",
                "  (:functions (total-cost))",
                ")"
            ],
            "task": [
                "(define (problem metric-task)",
                "  (:domain metric-domain)",
                "  (:init)",
                "  (:metric smallest (total-cost))",
                ")"
            ]
        },
        {
            "name": "invalid numeric effect operator",
            "entry": "domain",
            "expected_error": "InvalidNumericEffectError",
            "domain": [
                "(define (domain invalid-numeric-effect)",
                "  (:requirements :numeric-fluents)",
                "  (:predicates)",
                "  (:functions (total-cost))",
                "  (:action a :parameters () :effect (= (total-cost) 1))",
                ")"
            ]
        },
        {
            "name": "invalid numeric constraint comparator",
            "entry": "domain",
            "expected_error": "InvalidNumericConstraintError",
            "domain": [
                "(define (domain invalid-numeric-constraint)",
                "  (:requirements :numeric-fluents)",
                "  (:predicates)",
                "  (:functions (total-cost))",
                "  (:action a :parameters () :precondition (assign (total-cost) 1) :effect (and))",
                ")"
            ]
        },
        {
            "name": "probability out of range",
            "entry": "domain",
            "expected_error": "InvalidProbabilisticEffectError",
            "domain": [
                "(define (domain invalid-probability)",
                "  (:requirements :probabilistic-effects)",
                "  (:predicates (p))",
                "  (:action a :parameters () :effect (probabilistic 1.2 (p)))",
                ")"
            ]
        },
        {
            "name": "probability total above one",
            "entry": "domain",
            "expected_error": "InvalidProbabilisticEffectError",
            "domain": [
                "(define (domain invalid-probability-total)",
                "  (:requirements :probabilistic-effects)",
                "  (:predicates (p) (q))",
                "  (:action a :parameters () :effect (probabilistic 0.7 (p) 0.6 (q)))",
                ")"
            ]
        },
        {
            "name": "mismatched task domain",
            "entry": "task",
            "expected_error": "MismatchedDomainError",
            "expected_message": "Task references domain 'other-domain' but parser holds domain 'expected-domain'.",
            "expected_line": 2,
            "expected_column": 12,
            "domain": [
                "(define (domain expected-domain)",
                "  (:predicates)",
                ")"
            ],
            "task": [
                "(define (problem wrong-domain-task)",
                "  (:domain other-domain)",
                "  (:init)",
                ")"
            ]
        },
        {
            "name": "permissive numeric write requires numeric-fluents under bare action-costs",
            "entry": "domain",
            "expected_error": "MissingRequirementError",
            "expected_message": "Missing required PDDL requirement: :numeric-fluents",
            "strict": false,
            "domain": [
                "(define (domain write-fragment)",
                "  (:requirements :action-costs)",
                "  (:predicates (p))",
                "  (:functions (total-cost) (fuel))",
                "  (:action burn :parameters () :effect (assign (fuel) 5))",
                ")"
            ]
        },
        {
            "name": "permissive increase of non-total-cost requires numeric-fluents under bare action-costs",
            "entry": "domain",
            "expected_error": "MissingRequirementError",
            "expected_message": "Missing required PDDL requirement: :numeric-fluents",
            "strict": false,
            "domain": [
                "(define (domain increase-fragment)",
                "  (:requirements :action-costs)",
                "  (:predicates (p))",
                "  (:functions (total-cost) (fuel))",
                "  (:action burn :parameters () :effect (increase (fuel) 1))",
                ")"
            ]
        },
        {
            "name": "permissive function declaration requires a numeric requirement",
            "entry": "domain",
            "expected_error": "MissingRequirementError",
            "expected_message": "Missing required PDDL requirement: :numeric-fluents",
            "strict": false,
            "domain": [
                "(define (domain no-numeric-requirement)",
                "  (:requirements :strips)",
                "  (:predicates (p))",
                "  (:functions (fuel))",
                ")"
            ]
        },
        {
            "name": "permissive numeric read in init requires a numeric requirement",
            "entry": "task",
            "expected_error": "MissingRequirementError",
            "expected_message": "Missing required PDDL requirement: :numeric-fluents",
            "strict": false,
            "domain": [
                "(define (domain no-numeric-read)",
                "  (:requirements :strips)",
                "  (:predicates (p))",
                ")"
            ],
            "task": [
                "(define (problem no-numeric-read-task)",
                "  (:domain no-numeric-read)",
                "  (:init (= (fuel) 3))",
                "  (:goal (p))",
                ")"
            ]
        },
        {
            "name": "strict function type mismatch",
            "entry": "domain",
            "expected_error": "TypeMismatchError",
            "strict": true,
            "domain": [
                "(define (domain function-type-mismatch)",
                "  (:requirements :typing :numeric-fluents)",
                "  (:types room ball)",
                "  (:constants b - ball)",
                "  (:predicates)",
                "  (:functions (distance ?r - room))",
                "  (:action a :parameters () :effect (assign (distance b) 0))",
                ")"
            ]
        },
        {
            "name": "declared predicate arity mismatch",
            "entry": "domain",
            "expected_error": "ArityMismatchError",
            "domain": [
                "(define (domain bad-arity)",
                "  (:predicates (p ?x))",
                "  (:action a :parameters () :precondition (p) :effect (and))",
                ")"
            ]
        },
        {
            "name": "strict action-costs requires metric",
            "entry": "task",
            "expected_error": "SemanticError",
            "expected_message": "Missing total-cost metric for :action-costs",
            "strict": true,
            "domain": [
                "(define (domain action-cost-domain)",
                "  (:requirements :action-costs)",
                "  (:predicates)",
                "  (:functions (total-cost))",
                "  (:action pay :parameters () :effect (increase (total-cost) 1))",
                ")"
            ],
            "task": [
                "(define (problem action-cost-task)",
                "  (:domain action-cost-domain)",
                "  (:init (= (total-cost) 0))",
                ")"
            ]
        },
        {
            "name": "strict action-costs requires initial value",
            "entry": "task",
            "expected_error": "SemanticError",
            "expected_message": "Missing initial value for total-cost for :action-costs",
            "strict": true,
            "domain": [
                "(define (domain action-cost-domain)",
                "  (:requirements :action-costs)",
                "  (:predicates)",
                "  (:functions (total-cost))",
                "  (:action pay :parameters () :effect (increase (total-cost) 1))",
                ")"
            ],
            "task": [
                "(define (problem action-cost-task)",
                "  (:domain action-cost-domain)",
                "  (:init)",
                "  (:metric minimize (total-cost))",
                ")"
            ]
        },
        {
            "name": "strict action-costs requires total-cost function",
            "entry": "domain",
            "expected_error": "SemanticError",
            "expected_message": "Missing total-cost function for :action-costs",
            "strict": true,
            "domain": [
                "(define (domain action-cost-domain)",
                "  (:requirements :action-costs)",
                "  (:predicates (p))",
                "  (:action pay :parameters () :effect (increase (total-cost) 1))",
                ")"
            ]
